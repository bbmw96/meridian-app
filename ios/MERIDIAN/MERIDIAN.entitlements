<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Push Notifications: production required for App Store / TestFlight distribution -->
    <key>aps-environment</key>
    <string>production</string>

    <!-- Background task scheduler identifiers for currency rate refresh -->
    <key>com.apple.developer.background-task-scheduler-permitted-identifiers</key>
    <array>
        <string>com.meridian.app.currency-refresh</string>
        <string>com.meridian.app.intelligence-sync</string>
    </array>

    <!-- Associated Domains for Universal Links (deep linking into intelligence reports) -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:meridian.io</string>
        <string>webcredentials:meridian.io</string>
    </array>

    <!-- App Groups for potential widget/extension data sharing -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.meridian.app</string>
    </array>
</dict>
</plist>
